{
  "name": "studyhack-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "ingest": "tsx src/ingest/cli.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test $(find src -name '*.test.ts')"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@napi-rs/canvas": "^1.0.2",
    "@sentry/node": "^10.67.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "mathjs": "^13.2.3",
    "officeparser": "^4.2.0",
    "openai": "^4.67.0",
    "pg": "^8.12.0",
    "pgvector": "^0.2.0",
    "unpdf": "^0.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
