# StudyHack Agent Server — environment (all server-side; never expose to the client)

# Postgres (Neon) — app data, pgvector, LangGraph checkpoints
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Internal service auth — MUST match the value set on Vercel (Doc 2 §6.2)
INTERNAL_JWT_SECRET=replace-with-32+char-shared-secret

# Cloudflare R2 (read parsed Markdown / originals) — S3-compatible
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# LLM provider (agent inference)
OPENAI_API_KEY=

# LangSmith (tracing) — optional; failures must never block a response
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=studyhack

# Server
PORT=2024
